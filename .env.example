# Generate a unique value with: openssl rand -hex 32
MORNS_INGEST_TOKEN=replace-with-a-long-random-token
# Receiver coordinates determine where packets were heard. Use precise or
# deliberately approximate coordinates according to your publication policy.
MORNS_STATION_LATITUDE=
MORNS_STATION_LONGITUDE=
# Display-only observation zone estimate; this is not transmitter geolocation.
MORNS_STATION_RADIUS_KM=8
